NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/asoudeh
JWT_SECRET=replace-with-a-local-development-secret
AUTH_HASH_SECRET=replace-with-a-separate-random-auth-hash-secret
# Development-only OTP simulator and quick-login; never use with shared or production data.
OTP_DEV_SIMULATOR_ENABLED=true
OTP_DEV_FALLBACK_CODE=123456
OTP_DEV_QUICK_LOGIN_ENABLED=true
OTP_DEV_QUICK_LOGIN_PHONE=09120000000
OTP_RESEND_COOLDOWN_SECONDS=60
# SMS.ir Verify API settings. Obtain account values from SMS.ir; never use NEXT_PUBLIC_ here.
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_BASE_URL=https://api.sms.ir/v1
SMSIR_MODE=sandbox
SMSIR_OTP_PARAMETER_NAME=
CLIENT_URL=http://localhost:3000
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/asoudeh_test
