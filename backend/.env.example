NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/asoudeh
JWT_SECRET=replace-with-a-local-development-secret
AUTH_HASH_SECRET=replace-with-a-separate-random-auth-hash-secret
# Development-only simulator; OTP still requires manual verification.
OTP_DEV_SIMULATOR_ENABLED=true
OTP_DEV_FALLBACK_CODE=123456
OTP_RESEND_COOLDOWN_SECONDS=60
# SMS.ir Verify settings. Keep the API key only in this backend environment file.
SMSIR_API_KEY=
SMSIR_VERIFY_TEMPLATE_ID=123456
SMSIR_MODE=sandbox
# Optional OpenAI-compatible provider. Leave unset to keep the assistant unavailable.
# Configure only on the backend; user messages are sent to this provider when enabled.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
CLIENT_URL=http://localhost:3000
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/asoudeh_test
