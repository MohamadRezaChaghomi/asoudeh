{
  "name": "asoudeh-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smsir:sandbox": "vitest run src/tests/smsIrSandbox.integration.test.ts",
    "test:db": "vitest run src/tests/database.test.ts",
    "test:watch": "vitest",
    "db:ensure-indexes": "tsx scripts/ensure-indexes.ts",
    "db:report-orphans": "tsx scripts/report-orphans.ts",
    "db:restore-integrity": "tsx src/scripts/restoreIntegrity.ts",
    "perf:seed": "tsx src/scripts/performanceSeed.ts",
    "perf:measure": "tsx src/scripts/performanceMeasure.ts",
    "seed:system-categories": "tsx src/scripts/seedSystemCategories.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "asoudeh": "file:..",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "pino": "^9.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
